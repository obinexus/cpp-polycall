{
  "name": "@obinexusltd/cpp-polycall",
  "version": "1.0.0",
  "description": "C++17 RAII binding for the Polycall core (polycall >= 1.1.0, binding ABI 1).",
  "keywords": [
    "cpp",
    "c++",
    "cmake",
    "polycall",
    "libpolycall",
    "ffi"
  ],
  "homepage": "https://github.com/obinexus/cpp-polycall#readme",
  "bugs": {
    "url": "https://github.com/obinexus/cpp-polycall/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/cpp-polycall.git"
  },
  "license": "MIT",
  "author": {
    "name": "Nnamdi Michael Okpala",
    "email": "okpalan@protonmail.com"
  },
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./src/*": "./src/*",
    "./include/*": "./include/*",
    "./examples/*": "./examples/*",
    "./cmake/*": "./cmake/*",
    "./config": "./cpp-polycallrc",
    "./manifest": "./polycall-binding.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "include/",
    "examples/",
    "tests/",
    "scripts/",
    "cmake/",
    "CMakeLists.txt",
    "Makefile",
    "polycall-binding.json",
    "cpp-polycallrc",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "build": "make",
    "clean": "make clean",
    "test": "make test && node tests/package.test.js",
    "verify": "make verify-dry",
    "prepack": "npm run test && npm run verify"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  }
}
