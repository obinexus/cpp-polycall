{
  "name": "cpp-polycall",
  "version": "1.0.0",
  "package": "cpp-polycall",
  "language": "C++",
  "adapter": true,
  "ffi": true,
  "abi": 1,
  "config": "cpp-polycallrc",
  "core": "polycall >= 1.1.0 (binding ABI 1)",
  "core_repository": "https://github.com/obinexus/polycall",
  "repository": "https://github.com/obinexus/cpp-polycall",
  "entrypoint": "include/cpp_polycall/polycall.hpp",
  "implementation": "src/polycall.cpp",
  "cmake": "CMakeLists.txt",
  "build": "cmake -S . -B cmake-build -DCMAKE_PREFIX_PATH=<polycall prefix> && cmake --build cmake-build",
  "test": "ctest --test-dir cmake-build --output-on-failure",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>"
}
